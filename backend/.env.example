# Google AI (Gemini Flash)
GOOGLE_API_KEY=tu-api-key-de-google-ai

# LangSmith (observabilidad)
LANGSMITH_API_KEY=tu-api-key-de-langsmith
LANGSMITH_PROJECT=macrosnap

# Base de datos
DATABASE_URL=sqlite:///./macrosnap.db

# --- Auth ---
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esto-por-un-string-largo-y-aleatorio-antes-de-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=10080
VERIFICATION_TOKEN_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# URL pública donde se abrirá el link de verificación.
# Dev local (Expo web): http://localhost:8081
# Producción: http://tu-dominio (o el IP de Hetzner)
FRONTEND_URL=http://localhost:8081

# --- SMTP (provider-agnostic) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASSWORD=<App Password>
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASSWORD=re_...
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey, SMTP_PASSWORD=SG....
# Mailgun: SMTP_HOST=smtp.mailgun.org, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=MacroSnap
SMTP_START_TLS=true
SMTP_USE_TLS=false
